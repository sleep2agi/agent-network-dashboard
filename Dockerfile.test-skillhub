FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN node tests/skillhub-module.test.mjs
RUN npx eslint app/skillhub/page.tsx app/api/anet/skills/route.ts app/components/Sidebar.tsx app/components/MobileNav.tsx
RUN npm run build
CMD ["node", "tests/skillhub-module.test.mjs"]
